<Window x:Class="ImagePeek.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImagePeek 快速查看器"
        Width="1100" Height="760"
        WindowStartupLocation="CenterScreen"
        Icon="ImagePeek.ico"
        Background="#1B1B1F"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        AllowDrop="True">
    <Grid>
        <ScrollViewer x:Name="Scroll"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#1B1B1F">
            <Image x:Name="Img" Stretch="None" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="ZoomT"/>
                </Image.RenderTransform>
            </Image>
        </ScrollViewer>

        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Background="#CC26262B"
                CornerRadius="8" Padding="14,7" Margin="0,12,0,0">
            <TextBlock x:Name="TitleText" Foreground="#E4E4E7" TextAlignment="Center"/>
        </Border>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="#CC26262B"
                CornerRadius="8" Padding="12,6" Margin="12,0,0,12">
            <TextBlock x:Name="InfoText" Foreground="#9CA3AF" FontSize="11"/>
        </Border>
    </Grid>
</Window>
