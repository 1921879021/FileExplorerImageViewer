<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <RootNamespace>ImagePeek</RootNamespace>
    <AssemblyTitle>ImagePeek</AssemblyTitle>
    <Product>ImagePeek</Product>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImagePeek.Core\ImagePeek.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 载荷由根目录 build.ps1 打包生成（构建依赖项目 → pack-payload.ps1 → 构建 exe） -->
    <EmbeddedResource Include="obj\payload\*.gz" LogicalName="pp_%(Filename)" />
  </ItemGroup>

  <!-- 兜底：载荷缺失时重新打包（首次全新构建后需要再 build 一次） -->
  <Target Name="PackPayload" BeforeTargets="PrepareResourceNames" Condition="!Exists('$(MSBuildThisFileDirectory)obj\payload\version.txt.gz')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)pack-payload.ps1&quot; -OutDir &quot;$(MSBuildThisFileDirectory)obj\payload&quot; -PreviewDll &quot;$(MSBuildThisFileDirectory)..\ImagePeek.Preview\bin\$(Configuration)\net48\ImagePeek.Preview.dll&quot; -CoreDir &quot;$(MSBuildThisFileDirectory)..\ImagePeek.Core\bin\$(Configuration)\net48&quot;" />
  </Target>

</Project>
